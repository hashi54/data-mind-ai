# Environment Configuration Template for DataMind AI
# Copy this file to .env and adjust variables as needed

# Application Settings
APP_NAME="DataMind AI"
APP_ENV="development"
DEBUG=True
API_HOST="0.0.0.0"
API_PORT=8000
FRONTEND_PORT=8501

# Security & Auth
SECRET_KEY="datamind-ai-super-secret-key-change-in-production"
API_KEY_HEADER="X-API-Key"
ALLOWED_ORIGINS="*"

# Database Settings (Dual PostgreSQL & SQLite support)
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/datamind_db
# For SQLite fallback (default): sqlite:///./data/datamind.db
DATABASE_URL="sqlite:///./data/datamind.db"
DB_READONLY_USER="false"
DB_QUERY_TIMEOUT_SECONDS=30

# LLM Providers Configuration
# Supported: gemini, openai, anthropic, mock
LLM_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
LLM_MODEL_NAME="gemini-1.5-flash"
LLM_TEMPERATURE=0.1

# Vector Database & RAG
VECTOR_DB_TYPE="chroma"
VECTOR_DB_PATH="./data/vector_store"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Machine Learning Registry
MODEL_REGISTRY_PATH="./models"

# Storage Paths
UPLOAD_DIR="./data/raw"
PROCESSED_DIR="./data/processed"
DOCUMENTS_DIR="./documents/knowledge_base"
